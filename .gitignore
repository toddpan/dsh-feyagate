node_modules/
# lib/ is committed on purpose: the plugin manager's "GitHub repository" install
# fetches the repo as-is and refuses to run build scripts, so the built entry
# point must be present in git. Rebuild with `npm run build` before committing.
*.tgz
*.log
.DS_Store

# Local scratch: downloaded archives, extracted servers, generated manifests
.cache/
tmp/

# 冒烟测试的临时安装根目录（会写入下载包、state.json 与日志）
.smoke/
.smoke-install/

# 属主/看门狗测试的运行期夹具（每次跑都会改写 startedAt）
.smoke-ownership/
